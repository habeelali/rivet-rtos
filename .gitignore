# Generated by Cargo
/target/
**/*.rs.bk
Cargo.lock

# The Xtensa (ESP32-S3) crates build under their own `esp` toolchain fork
# outside the main workspace (see root Cargo.toml's `exclude`), so each
# has its own target dir the root `/target/` pattern above doesn't reach.
rivet-arch-xtensa/target/
rivet-bsp-esp32s3/target/
examples/esp32s3/target/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# QEMU instruction traces (can reach 100s of MB) and tool state
*.trace
qemu.log
/archive/
/.reasonix/
fuzz/target/
__pycache__/
